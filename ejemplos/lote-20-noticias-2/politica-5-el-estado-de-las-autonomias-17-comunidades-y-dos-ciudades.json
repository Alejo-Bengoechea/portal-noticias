        },
        {
          "texto": "artículo 143",
          "marcas": [
            "negrita"
          ]
        },
        {
          "texto": ", más lento y con competencias iniciales limitadas, y el del ",
          "marcas": []
        },
        {
          "texto": "artículo 151",
          "marcas": [
            "negrita"
          ]
        },
        {
          "texto": ", más rápido y con un techo competencial mayor.",
          "marcas": []
        }
