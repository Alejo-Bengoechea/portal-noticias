      "id": "b01",
      "tipo": "parrafo",
      "spans": [
        {
          "texto": "Cada vez que compras un café, una camisa o un billete de tren, una parte del precio que pagas no es para el vendedor: es el ",
          "marcas": []
        },
        {
          "texto": "Impuesto sobre el Valor Añadido (IVA)",
          "marcas": [
            "negrita"
          ]
        },
        {
          "texto": ". En España se aplica desde el ",
          "marcas": []
        },
        {
          "texto": "1 de enero de 1986",
          "marcas": [
            "negrita"
          ]
        },
        {
          "texto": ", cuando el país entró en la entonces Comunidad Económica Europea.",
          "marcas": []
        }
      ]
    },
    {
      "id": "b02",
      "tipo": "encabezado",
      "nivel": 2,
      "texto": "Tres tipos, según el producto"
    },
