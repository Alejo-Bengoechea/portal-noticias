    },
    {
      "id": "b10",
      "tipo": "encabezado",
      "nivel": 2,
      "texto": "Prevención de la tortura"
    },
    {
      "id": "b11",
      "tipo": "parrafo",
      "spans": [
        {
          "texto": "Desde ",
          "marcas": []
        },
        {
          "texto": "2009",
          "marcas": [
            "negrita"
          ]
        },
        {
          "texto": ", el Defensor del Pueblo ejerce también como ",
          "marcas": []
        },
        {
          "texto": "Mecanismo Nacional de Prevención de la Tortura",
          "marcas": [
            "negrita"
          ]
        },
        {
          "texto": ", en cumplimiento de un protocolo de Naciones Unidas. Por eso visita comisarías, prisiones, centros de menores o residencias, sin avisar, para comprobar las condiciones de las personas privadas de libertad.",
          "marcas": []
        }
      ]
    },
    {
      "id": "b12",
